rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTHENTICATION
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function callerProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function callerRole() {
      return userExists()
        ? callerProfile().access_role
        : null;
    }

    function callerMemberships() {
      return userExists()
        && callerProfile().membership_types is list
        ? callerProfile().membership_types
        : [];
    }

    // ============================================================
    // ACCESS ROLES
    // ============================================================

    function isAdmin() {
      return userExists()
        && callerRole() == "admin";
    }

    function isElectionOfficer() {
      return userExists()
        && callerRole() == "election_officer";
    }

    function isMember() {
      return userExists()
        && callerRole() == "member";
    }

    function isAdminOrElectionOfficer() {
      return isAdmin() || isElectionOfficer();
    }

    // ============================================================
    // ACCOUNT STATUS (suspension)
    // ============================================================

    /*
     * A suspended member is blocked from the platform. This is the
     * second layer — the app signs suspended members out reactively
     * (see src/contexts/AuthContext.tsx) and blocks their next
     * login. Reading the caller's own /users document stays allowed
     * so the client can detect the suspension and sign out. An
     * ABSENT `status` field counts as active.
     */
    function isActiveUser() {
      return isSignedIn()
        && userExists()
        && (
          !callerProfile().keys().hasAny(["status"])
          || callerProfile().status != "suspended"
        );
    }

    // ============================================================
    // MEMBERSHIP TYPES
    // ============================================================

    function isSocialMember() {
      return isMember()
        && callerMemberships().hasAny(["social_member"]);
    }

    function isCampaignMember() {
      return isMember()
        && callerMemberships().hasAny(["campaign_member"]);
    }

    // ============================================================
    // OWNERSHIP
    // ============================================================

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    // ============================================================
    // SECURITY ACCESS INDEX (user_access)
    // ============================================================

    /*
     * Access ID format:
     *
     *   UID__permission__scope_type__scope_id
     *
     * Global:
     *
     *   UID__permission__global
     */

    function hasGlobalAccess(permission) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/user_access/
          $(request.auth.uid + "__" + permission + "__global")
        )
        && get(
          /databases/$(database)/documents/user_access/
          $(request.auth.uid + "__" + permission + "__global")
        ).data.allowed == true
        && get(
          /databases/$(database)/documents/user_access/
          $(request.auth.uid + "__" + permission + "__global")
        ).data.user_id == request.auth.uid;
    }

    function hasScopedAccess(permission, scopeType, scopeId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/user_access/
          $(request.auth.uid + "__" + permission + "__" + scopeType + "__" + scopeId)
        )
        && get(
          /databases/$(database)/documents/user_access/
          $(request.auth.uid + "__" + permission + "__" + scopeType + "__" + scopeId)
        ).data.allowed == true
        && get(
          /databases/$(database)/documents/user_access/
          $(request.auth.uid + "__" + permission + "__" + scopeType + "__" + scopeId)
        ).data.user_id == request.auth.uid;
    }

    function hasAccess(permission, scopeType, scopeId) {
      return hasGlobalAccess(permission)
        || hasScopedAccess(permission, scopeType, scopeId);
    }

    /*
     * R8 — a user-set DATE must not be in the past.
     *
     * Campaign date fields are date-only ("YYYY-MM-DD" in the form) and
     * are stored as a Firestore timestamp at local midnight: the rules
     * language cannot parse a date string, so the stored shape is the
     * only thing the server can compare. The one-day grace keeps a
     * member in WAT who submits "today" at 11pm inside the window after
     * the server clock has already rolled over to the next UTC day.
     */
    /*
     * R8 — `get(key, default)` returns a STORED null, not the default.
     * Every optional campaign field is therefore tested through this
     * helper instead of `== ""` so an explicit null counts as absent.
     */
    function isBlank(value) {
      return value == null || value == "";
    }

    function isCurrentOrFutureDate(value) {
      return value == null
        || (
          value is timestamp
          && value >= request.time - duration.value(1, "d")
        );
    }

    /*
     * ============================================================
     * CAMPAIGN BASELINE SELF-PROVISIONING
     * ============================================================
     *
     * `user_access` writes are admin-only, with ONE narrow exception: a
     * member may write their own BASELINE documents after signup or
     * after their home area moves. Without it a plain campaign member
     * has zero grants and every campaign read is denied.
     *
     * The exception is deliberately clamped to the baseline shape (see
     * docs/campaign-member-baseline.md):
     *
     *   - the document's own user_id must be the caller
     *   - allowed must be true
     *   - `view_activities` at the caller's own polling unit, ward, LGA,
     *     zone or the state
     *   - view_members / view_assignments / submit_field_report /
     *     report_issue at the caller's own polling unit ONLY
     *   - the document id must be exactly derivable from the payload,
     *     so an id can never disagree with its contents
     *
     * It can never grant a coordinator permission, a permission above
     * the caller's own area, or a permission at somebody else's PU.
     * (The zone is not verifiable here: rules cannot walk the
     * LGA -> zone map, so the zone grant is limited to view_activities.)
     */

    function isBaselineAccessPayload(data) {
      return
        (
          data.permission == "view_activities"
          && (
            (data.scope_type == "state" && data.scope_id == "enugu-state")
            || data.scope_type == "senatorial_zone"
            || (
              data.scope_type == "lga"
              && data.scope_id == callerProfile().get("lga_id", "")
            )
            || (
              data.scope_type == "ward"
              && data.scope_id == callerProfile().get("ward_id", "")
            )
            || (
              data.scope_type == "polling_unit"
              && data.scope_id == callerProfile().get("polling_unit_id", "")
            )
          )
        )
        || (
          data.scope_type == "polling_unit"
          && data.scope_id == callerProfile().get("polling_unit_id", "")
          && data.permission in [
            "view_members",
            "view_assignments",
            "submit_field_report",
            "report_issue"
          ]
        );
    }

    function isDerivableAccessId(accessId, data) {
      return accessId == request.auth.uid
        + "__" + data.permission
        + "__" + data.scope_type
        + "__" + data.scope_id;
    }

    // ============================================================
    // ELECTION ACTIVITY
    // ============================================================

    /*
     * Election mode gates SUBMISSIONS, never dashboard visibility
     * for authorized roles. A member may only submit for the
     * ward/polling unit where they are registered.
     */

    function registeredAt(wardId, pollingUnitId) {
      return isMember()
        && callerProfile().ward_id == wardId
        && callerProfile().polling_unit_id == pollingUnitId;
    }

    function canSubmitElectionActivity(wardId, pollingUnitId) {
      return isAdminOrElectionOfficer()
        || registeredAt(wardId, pollingUnitId);
    }

    // ============================================================
    // ELECTION HELPERS (single-tenant)
    // ============================================================

    /*
     * Single-tenant: no tenant gate. Election actions are available to
     * any signed-in user that also passes the per-rule role/scope checks
     * below AND has the master election switch turned on.
     *
     * The switch lives on the single election_settings document as
     * `election_mode_enabled` (mirrored by setElectionMode() in
     * src/lib/firebase/election.ts). A missing document or a missing
     * field counts as ON so a fresh deployment is never locked out.
     */
    function electionSettingsDoc() {
      return /databases/$(database)/documents/election_settings/default;
    }

    function electionModeEnabled() {
      return isSignedIn()
        && (
          !exists(electionSettingsDoc())
          || !get(electionSettingsDoc()).data.keys().hasAny(["election_mode_enabled"])
          || get(electionSettingsDoc()).data.election_mode_enabled == true
        );
    }

    function canReadElectionResult(data) {
      return isAdmin()
        || isElectionOfficer()
        || data.submitted_by == request.auth.uid
        || registeredAt(data.ward_id, data.polling_unit_id)
        || hasGlobalAccess("view_election_results")
        || hasScopedAccess("view_election_results", "ward", data.ward_id)
        || hasScopedAccess("view_election_results", "polling_unit", data.polling_unit_id);
    }

    /*
     * Officer review: approve / reject / clarify / reopen.
     * Admins do NOT get approval authority (spec §27 / §33).
     */
    function officerReviewUpdate() {
      return isElectionOfficer()
        && request.resource.data.contest_id == resource.data.contest_id
        && request.resource.data.ward_id == resource.data.ward_id
        && request.resource.data.polling_unit_id == resource.data.polling_unit_id
        && request.resource.data.submitted_by == resource.data.submitted_by
        && request.resource.data.reviewed_by == request.auth.uid
        && request.resource.data.verified == (request.resource.data.status == "approved")
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "status", "verified", "review_notes", "reviewed_by",
              "reviewed_at", "history", "updated_at"
            ]);
    }

    function validOfficerTransition() {
      return
        // Pending → terminal
        ((resource.data.status == "submitted" || resource.data.status == "pending_review")
          && (request.resource.data.status == "approved"
            || request.resource.data.status == "rejected"
            || request.resource.data.status == "clarification_required"))
        ||
        // Clarification → back to queue
        (resource.data.status == "clarification_required"
          && (request.resource.data.status == "submitted"
            || request.resource.data.status == "pending_review"))
        ||
        // Approved → reopened
        (resource.data.status == "approved"
          && request.resource.data.status == "reopened")
        ||
        // Reopened → terminal
        (resource.data.status == "reopened"
          && (request.resource.data.status == "approved"
            || request.resource.data.status == "rejected"
            || request.resource.data.status == "clarification_required"))
        ||
        // Rejected → back to queue
        (resource.data.status == "rejected"
          && (request.resource.data.status == "submitted"
            || request.resource.data.status == "pending_review"));
    }

    /*
     * Admin correction (spec §32) — preserves identity and
     * forces re-review. Admin may not approve.
     */
    function adminCorrectionUpdate() {
      return isAdmin()
        && request.resource.data.contest_id == resource.data.contest_id
        && request.resource.data.ward_id == resource.data.ward_id
        && request.resource.data.polling_unit_id == resource.data.polling_unit_id
        && request.resource.data.submitted_by == resource.data.submitted_by
        && request.resource.data.status == "pending_review"
        && request.resource.data.verified == false
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["results", "status", "verified", "history", "updated_at"]);
    }

    // ============================================================
    // ACTIVE CONTEST SCOPE (round 4)
    // ============================================================

    /*
     * No upload may leave the active contest's footprint. The active
     * contest is election_settings.default.active_contest_id, and its
     * geographic scope is checked against the submitted LGA:
     *
     *   national / state  -> every LGA allowed
     *   lga               -> exactly scope_id
     *   zone/constituency -> LGA must be listed on lga_ids; an absent
     *                        or empty lga_ids stays unrestricted (the
     *                        client resolves legacy rows via the
     *                        constituency reference)
     */
    function hasActiveContest() {
      return exists(electionSettingsDoc())
        && get(electionSettingsDoc()).data.keys().hasAny(["active_contest_id"])
        && get(electionSettingsDoc()).data.active_contest_id is string
        && get(electionSettingsDoc()).data.active_contest_id.size() > 0;
    }

    function activeContestDoc() {
      return /databases/$(database)/documents/election_contests/
        $(get(electionSettingsDoc()).data.active_contest_id);
    }

    function contestAllowsLga(contestData) {
      return
        contestData.scope_type in ["national", "state"]
        || (
          contestData.scope_type == "lga"
          && contestData.scope_id == request.resource.data.lga_id
        )
        || (
          contestData.scope_type in
            ["senatorial_zone", "federal_constituency", "state_constituency"]
          && (
            !contestData.keys().hasAny(["lga_ids"])
            || !(contestData.lga_ids is list)
            || contestData.lga_ids.size() == 0
            || request.resource.data.lga_id in contestData.lga_ids
          )
        );
    }

    function activeContestAllowsLga() {
      return hasActiveContest()
        && exists(activeContestDoc())
        && request.resource.data.lga_id is string
        && request.resource.data.lga_id.size() > 0
        && contestAllowsLga(get(activeContestDoc()).data);
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.access_role == "member"
        && request.resource.data.points == 0;

      allow update: if isOwner(userId)
        && request.resource.data.access_role
          == resource.data.access_role
        && request.resource.data.membership_types
          == resource.data.membership_types
        && request.resource.data.points
          == resource.data.points
        && request.resource.data.rank
          == resource.data.rank;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ============================================================
    // SITE SETTINGS
    // ============================================================

    match /site_settings/{settingsId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // SOCIAL MEDIA TASKS
    // ============================================================

    match /tasks/{taskId} {

      allow read: if isAdmin();

      allow read: if isSocialMember()
        && resource.data.status == "active";

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // INEC OFFICER REGISTRATIONS
    // ============================================================

    match /inec_officers/{officerId} {

      allow read: if isAdmin();

      allow create: if true;

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // TASK SUBMISSIONS
    // ============================================================

    match /task_submissions/{submissionId} {

      allow read: if isAdmin();

      allow read: if isSocialMember()
        && resource.data.user_id == request.auth.uid;

      allow create: if isSocialMember()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == "pending"
        && exists(
          /databases/$(database)/documents/tasks/
          $(request.resource.data.task_id)
        )
        && get(
          /databases/$(database)/documents/tasks/
          $(request.resource.data.task_id)
        ).data.status == "active"
        && submissionId
          == request.resource.data.task_id
             + "_"
             + request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ============================================================
    // NEWS
    // ============================================================

    match /news/{newsId} {

      allow read: if
        resource.data.status == "published"
        || resource.data.published == true
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // HOMEPAGE EVENTS (public read when published)
    // ============================================================

    match /events/{eventId} {

      /*
       * The public homepage lists published, upcoming events. Drafts
       * stay admin-only, so the read gate mirrors /manifestos.
       */
      allow read: if
        resource.data.status == "published"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // PUBLIC CONTENT (SINGLE CAMPAIGN, FLAT DOCS)
    // ============================================================

    match /biographies/{docId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    match /manifestos/{docId} {

      allow read: if
        resource.data.status == "published"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }

    match /galleries/{docId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    match /portal_content/{docId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // NOTIFICATIONS (per-user inbox)
    // ============================================================

    /*
     * One document per recipient. A member reads and marks read only
     * their OWN rows; admin may read and delete for support.
     *
     * Any signed-in actor may CREATE a row for another user (that is the
     * fan-out: the actor's session writes the recipients' inboxes), but
     * the actor id must be the caller and the payload must match the
     * nine-event vocabulary exactly. `created_at` must be the request
     * time; the writer always uses serverTimestamp().
     */
    match /notifications/{notificationId} {

      allow read: if isAdmin();

      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.user_id is string
        && request.resource.data.user_id.size() > 0
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.type in [
          "assignment_created",
          "assignment_completed",
          "assignment_approved",
          "assignment_rejected",
          "report_reviewed",
          "issue_raised",
          "issue_status_changed",
          "activity_created",
          "role_assigned"
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.link is string
        && request.resource.data.entity_type is string
        && request.resource.data.entity_id is string
        && request.resource.data.read == false
        && request.resource.data.created_at == request.time;

      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["read", "read_at"])
        && request.resource.data.read == true;

      allow delete: if isAdmin();
    }

    // ============================================================
    // CONTACT MESSAGES (PUBLIC INBOX)
    // ============================================================

    match /contact_messages/{messageId} {

      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() < 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000;

      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // APP CONFIG (config/app)
    // ============================================================

    match /config/{configId} {
      allow read: if true;

      allow write: if isAdmin();
    }

    // ============================================================
    // ORGANIZATIONAL ASSIGNMENTS
    // ============================================================

    match /organizational_assignments/{assignmentId} {

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.user_id == request.auth.uid
        );

      /*
       * R2 — a coordinator may read the assignments of members inside
       * the scope they cover, which is what the Members page needs to
       * list "coordinators in my area" with their position and
       * sub-scope. `user_access` carries the position's scope grants.
       */
      allow read: if isSignedIn()
        && hasAccess(
          "view_members",
          resource.data.scope_type,
          resource.data.scope_id
        );

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // PERMISSION GRANTS
    // ============================================================

    match /permission_grants/{grantId} {

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.user_id == request.auth.uid
        );

      allow create: if isAdmin()
        && request.resource.data.granted_by == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // FIRESTORE SECURITY ACCESS INDEX
    // ============================================================

    match /user_access/{accessId} {

      allow read: if false;

      /*
       * R7 — admins may read the whole index.
       *
       * A recompute triggered by an admin (demotion, role change,
       * membership removal) runs in the admin's session and must
       * enumerate the TARGET user's existing grants to delete the ones
       * that are no longer expected. Admins already write and delete
       * these documents, so reading them adds no authority.
       */
      allow read: if isAdmin();

      /*
       * R7 — a member may read their OWN grants.
       *
       * The projection has to delete grants that are no longer expected,
       * which means it must know which ones EXIST. `access_projection_ids`
       * on the profile records what this projection wrote, but a document
       * written before that field existed (or by another writer) is
       * invisible to it — the reason a demoted coordinator kept a full
       * set of grants. Enumerating `where("user_id", "==", uid)` is
       * provable against this clause.
       *
       * It exposes the caller's own entitlements only: the rule compares
       * the document's user_id with the authenticated uid, so no query
       * can reach another user's documents.
       */
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      allow create, update: if isAdmin()
        && request.resource.data.user_id is string
        && request.resource.data.permission is string
        && request.resource.data.allowed is bool;

      /*
       * R6 — a member provisions their OWN baseline. See the
       * `isBaselineAccessPayload()` helper above for the exact clamp.
       */
      allow create: if isSignedIn()
        && userExists()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.allowed == true
        && request.resource.data.scope_type is string
        && request.resource.data.scope_id is string
        && isBaselineAccessPayload(request.resource.data)
        && isDerivableAccessId(accessId, request.resource.data);

      allow update: if isSignedIn()
        && userExists()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.allowed == true
        && isBaselineAccessPayload(request.resource.data)
        && isDerivableAccessId(accessId, request.resource.data);

      allow delete: if isAdmin();

      /* A member may drop their own baseline (moving home area, losing
       * campaign membership happens through an admin). */
      allow delete: if isSignedIn()
        && userExists()
        && resource.data.user_id == request.auth.uid;
    }

    // ============================================================
    // CAMPAIGN ACTIVITIES
    // ============================================================

    match /campaign_activities/{activityId} {

      /* R8 — an update may clear or move the date, never backdate it. */
      function activityDateChangedValid() {
        return !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(["date"])
          || (
            request.resource.data.get("date", null) is timestamp
            && isCurrentOrFutureDate(request.resource.data.get("date", null))
          );
      }

      allow read: if isAdmin();

      allow read: if isSignedIn()
        && hasAccess(
          "view_activities",
          resource.data.scope_type,
          resource.data.scope_id
        );

      /*
       * Membership read: an activity is visible to the scope it was
       * created at and everything below it. The writer stamps the ward
       * and (for PU-scoped rows) polling-unit audience at create time.
       * A PU-scoped activity is readable only by that PU; everything
       * else is readable by every member of the stamped wards.
       */
      /*
       * R7 — a PU-scoped activity inside a coordinator's ward.
       *
       * The membership clause below only reaches the PU's own members,
       * so a ward coordinator could not see work logged at a polling
       * unit in their own ward. The writer stamps `scope_ward_id`, and
       * the coordinator holds `view_activities` for that ward; both the
       * rule and the query can then agree on a single field.
       */
      allow read: if isSignedIn()
        && resource.data.get("scope_ward_id", "") != ""
        && hasAccess(
          "view_activities",
          "ward",
          resource.data.get("scope_ward_id", "")
        );

      allow read: if isSignedIn()
        && isCampaignMember()
        && (
          (
            resource.data.get("visibility_pu_ids", []).size() > 0
            && callerProfile().polling_unit_id
              in resource.data.get("visibility_pu_ids", [])
          )
          ||
          (
            resource.data.get("visibility_pu_ids", []).size() == 0
            && callerProfile().ward_id
              in resource.data.get("visibility_ward_ids", [])
          )
        );

      /*
       * R8 — the scheduled date must be today or later, and is stored as
       * a timestamp (see `isCurrentOrFutureDate()`).
       */
      allow create: if isSignedIn()
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.get("date", null) is timestamp
        && isCurrentOrFutureDate(request.resource.data.get("date", null))
        && hasAccess(
          "create_activity",
          request.resource.data.scope_type,
          request.resource.data.scope_id
        );

      allow update: if isAdmin()
        && activityDateChangedValid();

      allow update: if isSignedIn()
        && hasAccess(
          "manage_activity",
          resource.data.scope_type,
          resource.data.scope_id
        )
        && activityDateChangedValid();

      allow delete: if isAdmin();

      allow delete: if isSignedIn()
        && hasAccess(
          "manage_activity",
          resource.data.scope_type,
          resource.data.scope_id
        );
    }

    // ============================================================
    // CAMPAIGN ASSIGNMENTS
    // ============================================================

    match /campaign_assignments/{assignmentId} {

      /*
       * R8 — WHO a coordinator may hand work to.
       *
       * The rules cannot walk LGA -> ward -> polling unit, so "at or
       * below my scope" is answered from the CALLER'S GRANTS: a target
       * is covered when the caller holds `create_assignment` at the
       * target's own polling unit, ward or LGA. The campaign projection
       * writes an LGA assignment's grants at the LGA AND every ward in
       * it, so this is exactly "the target's home area is inside my
       * authority" for every position. One `get()` on the target.
       */
      function callerCoversUser(userData) {
        return hasGlobalAccess("create_assignment")
          || (
            !isBlank(userData.get("polling_unit_id", null))
            && hasAccess(
              "create_assignment",
              "polling_unit",
              userData.get("polling_unit_id", null)
            )
          )
          || (
            !isBlank(userData.get("ward_id", null))
            && hasAccess(
              "create_assignment",
              "ward",
              userData.get("ward_id", null)
            )
          )
          || (
            !isBlank(userData.get("lga_id", null))
            && hasAccess(
              "create_assignment",
              "lga",
              userData.get("lga_id", null)
            )
          );
      }

      function targetUserIsCovered(data) {
        return isBlank(data.get("assigned_to_user", null))
          || (
            data.assigned_to_user is string
            && data.assigned_to_user.matches("^[A-Za-z0-9_-]{1,128}$")
            && callerCoversUser(
              get(
                /databases/$(database)/documents/users/$(data.assigned_to_user)
              ).data
            )
          );
      }

      /*
       * R8 — WHERE a scope-targeted assignment may point.
       *
       * An exact `create_assignment` grant at the target scope, or one
       * at the ward stamped on the row (`target_ward_id` covers ward and
       * polling-unit targets). The campaign projection writes an LGA or
       * zone coordinator's grants at every ward inside their area, so a
       * ward stamp is always provable for work below their own scope.
       */
      function scopeGrantCoversTarget(scopeType, scopeId, targetWardId) {
        return hasAccess("create_assignment", scopeType, scopeId)
          || (
            !isBlank(targetWardId)
            && hasAccess("create_assignment", "ward", targetWardId)
          );
      }

      function scopeTargetIsCovered(data) {
        return data.get("assigned_to_scope", null) == null
            && isBlank(data.get("scope_type", null))
          ? true
          : (
            data.get("assigned_to_scope", null) is map
              ? scopeGrantCoversTarget(
                  data.assigned_to_scope.level,
                  data.assigned_to_scope.scope_id,
                  data.get("target_ward_id", null)
                )
              : scopeGrantCoversTarget(
                  data.get("scope_type", null),
                  data.get("scope_id", null),
                  data.get("target_ward_id", null)
                )
          );
      }

      /* R8 — an update may move the due date, never backdate it. */
      function assignmentDateChangedValid() {
        return !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(["due_date", "due_at"])
          || (
            isCurrentOrFutureDate(request.resource.data.get("due_date", null))
            && isCurrentOrFutureDate(request.resource.data.get("due_at", null))
          );
      }

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.assigned_to == request.auth.uid
        );

      /*
       * R3 — dual-target reads.
       *
       *   individual target ... the assignee (new + legacy field)
       *   creator ............. their own assignments
       *   scope target ........ the target scope and everything below,
       *                         via the target's own scope document and
       *                         the ward stamp written at create time
       */
      allow read: if isSignedIn()
        && resource.data.get("assigned_to_user", "") == request.auth.uid;

      /*
       * R7 — legacy assignee / creator fields.
       *
       * `getAssignmentsForUser()` queries both the Round 5 field and the
       * pre-Round 5 one it falls back to (`assigned_to` / `assigned_by`).
       * Without these clauses those two queries could not be proven and
       * the WHOLE read failed for every non-admin.
       */
      allow read: if isSignedIn()
        && resource.data.get("assigned_to", "") == request.auth.uid;

      allow read: if isSignedIn()
        && resource.data.get("assigned_by", "") == request.auth.uid;

      allow read: if isSignedIn()
        && resource.data.get("created_by", "") == request.auth.uid;

      allow read: if isSignedIn()
        && hasAccess(
          "view_assignments",
          resource.data.scope_type,
          resource.data.scope_id
        );

      allow read: if isSignedIn()
        && resource.data.get("target_ward_id", "") != ""
        && hasAccess(
          "view_assignments",
          "ward",
          resource.data.get("target_ward_id", "")
        );

      /*
       * Creation is checked against the TARGET: an admin may target
       * anything, a coordinator only work inside their own authority
       * (individual targets by the target's home area, scope targets by
       * the target scope or its ward stamp). Due dates must be today or
       * later. The client also limits the pickers to the same set, so
       * the two agree rather than one relying on the other.
       */
      allow create: if isAdmin()
        && isCurrentOrFutureDate(request.resource.data.get("due_date", null))
        && isCurrentOrFutureDate(request.resource.data.get("due_at", null));

      allow create: if isSignedIn()
        && request.resource.data.get("created_by", "") == request.auth.uid
        && (
          !isBlank(request.resource.data.get("assigned_to_user", null))
          || request.resource.data.get("assigned_to_scope", null) != null
        )
        && targetUserIsCovered(request.resource.data)
        && scopeTargetIsCovered(request.resource.data)
        && isCurrentOrFutureDate(request.resource.data.get("due_date", null))
        && isCurrentOrFutureDate(request.resource.data.get("due_at", null));

      allow delete: if isAdmin();

      allow update: if isAdmin()
        && assignmentDateChangedValid();

      allow update: if isSignedIn()
        && resource.data.get("created_by", "") == request.auth.uid
        && assignmentDateChangedValid();

      /*
       * Per-person completion records.
       */
      match /completions/{userId} {

        allow read: if isAdmin()
          || request.auth.uid == userId
          || (
            isSignedIn()
            && get(
              /databases/$(database)/documents/campaign_assignments/$(assignmentId)
            ).data.get("created_by", "") == request.auth.uid
          );

        allow create: if isAdmin()
          || (
            isSignedIn()
            && get(
              /databases/$(database)/documents/campaign_assignments/$(assignmentId)
            ).data.get("created_by", "") == request.auth.uid
          );

        allow update: if isAdmin()
          || request.auth.uid == userId
          || (
            isSignedIn()
            && get(
              /databases/$(database)/documents/campaign_assignments/$(assignmentId)
            ).data.get("created_by", "") == request.auth.uid
          );

        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // CAMPAIGN FIELD REPORTS
    // ============================================================

    match /campaign_field_reports/{reportId} {

      allow read: if isSignedIn()
        && resource.data.submitted_by == request.auth.uid;

      allow read: if isAdmin();

      /*
       * R4 — the assignment's creator sees every report against their
       * own assignments. Combined with the two reads above this is the
       * COMPLETE visibility model: submitter + creator + admin. It is
       * deliberately not cascade-up, so there is no scope-based read.
       */
      allow read: if isSignedIn()
        && resource.data.get("assignment_creator_id", "")
          == request.auth.uid;

      allow read: if isSignedIn()
        && hasAccess(
          "review_field_report",
          resource.data.scope_type,
          resource.data.scope_id
        );

      allow create: if isSignedIn()
        && request.resource.data.submitted_by == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.get("assignment_id", "") is string
        && hasAccess(
          "submit_field_report",
          request.resource.data.scope_type,
          request.resource.data.scope_id
        );

      allow update: if isAdmin();

      allow update: if isSignedIn()
        && hasAccess(
          "review_field_report",
          resource.data.scope_type,
          resource.data.scope_id
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // CAMPAIGN ISSUES
    // ============================================================

    match /issues/{issueId} {

      allow read: if isAdmin();

      allow read: if isSignedIn()
        && resource.data.get("raised_by", "") == request.auth.uid;

      allow read: if isSignedIn()
        && resource.data.reported_by == request.auth.uid;

      allow read: if isSignedIn()
        && hasAccess(
          "manage_issue",
          resource.data.scope_type,
          resource.data.scope_id
        );

      /*
       * R5 — cascade UP. An issue raised at a polling unit is readable
       * by the coordinator of its ward, LGA, zone or state. The writer
       * stamps `scope_ward_id`, and the coordinator holds "manage_issue"
       * for every ward inside their scope, so a single ward-level check
       * covers the whole chain without a PU document per polling unit.
       */
      allow read: if isSignedIn()
        && resource.data.get("scope_ward_id", "") != ""
        && hasAccess(
          "manage_issue",
          "ward",
          resource.data.get("scope_ward_id", "")
        );

      allow create: if isSignedIn()
        && request.resource.data.reported_by == request.auth.uid
        && request.resource.data.status == "reported"
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.scope_type is string
        && request.resource.data.scope_id is string
        && hasAccess(
          "report_issue",
          request.resource.data.scope_type,
          request.resource.data.scope_id
        );

      allow update: if isAdmin();

      allow update: if isSignedIn()
        && hasAccess(
          "manage_issue",
          resource.data.scope_type,
          resource.data.scope_id
        );

      /* Same ward-level cascade for acknowledge / resolve. */
      allow update: if isSignedIn()
        && resource.data.get("scope_ward_id", "") != ""
        && hasAccess(
          "manage_issue",
          "ward",
          resource.data.get("scope_ward_id", "")
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // ELECTION CONFIG (cycles, contests, parties, candidates, settings)
    // ============================================================

    match /election_cycles/{cycleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /election_contests/{contestId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /political_parties/{partyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /election_candidates/{candidateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /election_settings/{settingsId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
    }

    // ============================================================
    // ELECTION RESULTS — full lifecycle
    // ============================================================

    match /election_results/{resultId} {

      allow read: if isActiveUser()
        && canReadElectionResult(resource.data);

      allow create: if isActiveUser()
        && electionModeEnabled()
        && !exists(
          /databases/$(database)/documents/election_results/$(resultId)
        )
        && request.resource.data.submitted_by == request.auth.uid
        && request.resource.data.contest_id is string
        && request.resource.data.lga_id is string
        && request.resource.data.ward_id is string
        && request.resource.data.polling_unit_id is string
        && request.resource.data.results is list
        && request.resource.data.results.size() > 0
        && request.resource.data.status == "submitted"
        && request.resource.data.verified == false
        && request.resource.data.cloudinary_url is string
        && (
          // Support both ID formats: contest__pu and ward__pu
          resultId == request.resource.data.contest_id + "__"
                      + request.resource.data.polling_unit_id
          || resultId == request.resource.data.ward_id + "__"
                      + request.resource.data.polling_unit_id
        )
        // Round 4: submission target is the ACTIVE contest, and the
        // polling unit must sit inside its geographic scope. (The
        // result_submitted audit entry is written in the same client
        // batch — see src/lib/firebase/election.ts.)
        && hasActiveContest()
        && request.resource.data.contest_id
            == get(electionSettingsDoc()).data.active_contest_id
        && activeContestAllowsLga()
        && (
          isAdminOrElectionOfficer()
          || registeredAt(
              request.resource.data.ward_id,
              request.resource.data.polling_unit_id
            )
          /*
           * Round 10: a coordinator may submit for any polling unit in
           * their assignment scope. The `upload_election_result`
           * projection carries a ward grant for every ward the
           * assignment covers, plus a global grant for a state /
           * campaign assignment. The active-contest clauses ABOVE are
           * unchanged and still bound every role.
           */
          || hasGlobalAccess("upload_election_result")
          || hasScopedAccess(
              "upload_election_result",
              "ward",
              request.resource.data.ward_id
            )
        );

      // Officer review (approve / reject / clarify / reopen).
      allow update: if officerReviewUpdate() && validOfficerTransition();

      // Admin correction (forces re-review).
      allow update: if adminCorrectionUpdate();

      /*
       * Permanent deletion (round 4). Officers and admins may delete
       * a submitted result — but only in a batch that ALSO writes the
       * append-only audit entry carrying the full snapshot and a
       * reason. getAfter() proves the batch contains that entry before
       * the delete commits; both writes commit or neither does.
       */
      allow delete: if isActiveUser()
        && isAdminOrElectionOfficer()
        && getAfter(
          /databases/$(database)/documents/election_audit/$(resultId + "__deleted__" + request.auth.uid)
        ).data.action == "result_deleted"
        && getAfter(
          /databases/$(database)/documents/election_audit/$(resultId + "__deleted__" + request.auth.uid)
        ).data.target_doc_id == resultId
        && getAfter(
          /databases/$(database)/documents/election_audit/$(resultId + "__deleted__" + request.auth.uid)
        ).data.reason is string
        && getAfter(
          /databases/$(database)/documents/election_audit/$(resultId + "__deleted__" + request.auth.uid)
        ).data.reason.size() > 0
        && getAfter(
          /databases/$(database)/documents/election_audit/$(resultId + "__deleted__" + request.auth.uid)
        ).data.snapshot is map;
    }

    // ============================================================
    // ELECTION AUDIT — APPEND-ONLY TRAIL
    // ============================================================

    match /election_audit/{auditId} {
      allow read: if isActiveUser() && isAdminOrElectionOfficer();

      /*
       * Create is split by actor so the trail covers the whole
       * lifecycle yet stays unforgeable:
       *
       *   - Officers/admins may append any correctly shaped entry
       *     (review actions, corrections, deletions with snapshot).
       *   - A member may ONLY append their own "result_submitted"
       *     entry, and only when the result it points at — written in
       *     the same batch — is their own submission (proven via
       *     getAfter() on the target).
       */
      allow create: if isActiveUser()
        && request.resource.data.action in [
          "result_submitted", "result_corrected",
          "result_approved", "result_rejected",
          "result_clarification_required", "result_reopened",
          "result_deleted"
        ]
        && request.resource.data.target_collection in
          ["election_results", "pu_reports", "election_incidents"]
        && request.resource.data.target_doc_id is string
        && request.resource.data.target_doc_id.size() > 0
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.actor_name is string
        && request.resource.data.actor_role is string
        && request.resource.data.at == request.time
        && request.resource.data.metadata is map
        && (
          // Deletions: audit goes in the same batch as the delete.
          request.resource.data.action != "result_deleted"
          || (
            !isMember()
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.snapshot is map
          )
        )
        && (
          isAdminOrElectionOfficer()
          || (
            request.resource.data.action == "result_submitted"
            && request.resource.data.target_collection == "election_results"
            && getAfter(
              /databases/$(database)/documents/election_results/$(request.resource.data.target_doc_id)
            ).data.submitted_by == request.auth.uid
          )
        );

      /*
       * Re-delete edge case: if a deleted target gets resubmitted and
       * deleted again, the deterministic delete entry
       * (<target>__deleted__<uid>) is overwritten by its own author —
       * and ONLY by its own author, only for the same target, and
       * only with another result_deleted entry. Every other path stays
       * read-only forever.
       */
      allow update: if isActiveUser()
        && isAdminOrElectionOfficer()
        && auditId == request.resource.data.target_doc_id
                       + "__deleted__" + request.auth.uid
        && request.resource.data.action == "result_deleted"
        && resource.data.action == "result_deleted"
        && resource.data.target_doc_id
            == request.resource.data.target_doc_id
        && resource.data.actor_id == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.snapshot is map;

      /*
       * The trail is append-only: an audit entry can never be
       * modified (except the ruled re-delete overwrite above) or
       * removed by anyone, including admins.
       */
      allow delete: if false;
    }

    // ============================================================
    // POLLING UNIT REPORTS
    // ============================================================

    match /pu_reports/{reportId} {

      allow read: if isActiveUser() && isAdmin();

      allow read: if isActiveUser()
        && (
          resource.data.submitted_by == request.auth.uid
          || isElectionOfficer()
          || hasGlobalAccess("view_election_results")
          || hasScopedAccess("view_election_results", "ward", resource.data.ward_id)
          || hasScopedAccess("view_election_results", "polling_unit", resource.data.polling_unit_id)
        );

      /*
       * Round-5 read ownership: a member always sees the PU reports
       * of the polling unit they are registered at — same grant the
       * election_results rule carries via registeredAt().
       */
      allow read: if isActiveUser()
        && registeredAt(resource.data.ward_id, resource.data.polling_unit_id);

      allow create: if isActiveUser()
        && request.resource.data.submitted_by == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.ward_id is string
        // Round 4: nobody — admin included — writes outside the
        // active contest's geographic scope.
        && activeContestAllowsLga()
        && (
          isAdminOrElectionOfficer()
          || registeredAt(
              request.resource.data.ward_id,
              request.resource.data.polling_unit_id
            )
        );

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // ELECTION INCIDENTS
    // ============================================================

    match /election_incidents/{incidentId} {

      allow read: if isActiveUser() && isAdmin();

      allow read: if isActiveUser()
        && (
          resource.data.reported_by == request.auth.uid
          || isElectionOfficer()
          || hasGlobalAccess("view_election_results")
          || hasScopedAccess("view_election_results", "ward", resource.data.ward_id)
          || (
            resource.data.polling_unit_id != null
            && hasScopedAccess(
              "view_election_results",
              "polling_unit",
              resource.data.polling_unit_id
            )
          )
        );

      /*
       * Round-5 read ownership: a member sees PU-level incidents at
       * the polling unit they are registered at. (Ward-level
       * incidents — polling_unit_id unset — remain visible only to
       * ward-scoped projections, admins and officers.)
       */
      allow read: if isActiveUser()
        && resource.data.polling_unit_id != null
        && registeredAt(resource.data.ward_id, resource.data.polling_unit_id);

      allow create: if isActiveUser()
        && request.resource.data.reported_by == request.auth.uid
        && request.resource.data.status == "reported"
        && request.resource.data.description is string
        && request.resource.data.ward_id is string
        // Round 4: nobody — admin included — writes outside the
        // active contest's geographic scope.
        && activeContestAllowsLga()
        && (
          isAdminOrElectionOfficer()
          || (
            isCampaignMember()
            && callerProfile().ward_id == request.resource.data.ward_id
            // Round-5: a PU-level incident must come from the
            // member's OWN registered polling unit. A ward-level
            // incident (no PU attached) stays ward-registered.
            && (
              request.resource.data.polling_unit_id == null
              || (
                request.resource.data.polling_unit_id is string
                && request.resource.data.polling_unit_id.size() > 0
                && callerProfile().polling_unit_id
                  == request.resource.data.polling_unit_id
              )
            )
          )
        );

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // ELECTORAL DATA — public read, admin only via SDK/scripts
    // ============================================================

    match /electoral_data/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // STRUCTURE MEMBERS
    // ============================================================

    match /structure_members/{memberId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}